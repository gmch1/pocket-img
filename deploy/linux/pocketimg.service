# Managed by PocketIMG installer v1
[Unit]
Description=PocketIMG image hosting backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pocketimg
Group=pocketimg
ExecStart=/bin/bash -c 'source /etc/pocketimg/service.env; exec /usr/local/bin/pocketimg'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/pocketimg
ReadWritePaths=/var/lib/pocketimg

[Install]
WantedBy=multi-user.target
